# Multi-Tenants HR — environment template
# Copy to `.env` (git-ignored) and fill in as needed.
#
# Data source for the application. Use `mock` for deterministic demo data or
# `supabase` for local/hosted persistence.
VITE_DATA_SOURCE=mock

# Supabase browser configuration. Use the publishable/anon key only. These are
# build-time frontend variables; never place a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Never place a Supabase service-role key in the frontend or in any VITE_* var.
