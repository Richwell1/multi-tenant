# Multi-Tenants HR — environment template
# Copy to `.env` (git-ignored) and fill in as needed.
#
# The frontend consumes NO runtime env vars yet — this file documents the
# variables that tooling and the future backend phase will use.

# Google Stitch MCP (design source of truth). Referenced by .mcp.json.
STITCH_API_KEY=

# --- Supabase (backend phase) ------------------------------------------------
# Publishable/anon key only — safe for the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Never place a Supabase service-role key in the frontend or in any VITE_* var.
